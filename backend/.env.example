APP_ENV=development
APP_NAME=Nao Translation Bridge API
DATABASE_URL=sqlite:///./nao_medical.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

AI_PROVIDER=groq
GROQ_API_KEY=replace_with_real_key
GROQ_TRANSLATION_MODEL=llama-3.1-8b-instant
GROQ_SUMMARY_MODEL=llama-3.3-70b-versatile
GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo
GEMINI_API_KEY=
GEMINI_TRANSLATION_MODEL=gemini-2.0-flash
GEMINI_SUMMARY_MODEL=gemini-2.0-flash
GEMINI_TRANSCRIBE_MODEL=gemini-2.0-flash
AI_TIMEOUT_SECONDS=20

# Leave S3 values empty to disable audio uploads locally.
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

MAX_AUDIO_MB=15
ALLOWED_AUDIO_MIME=audio/webm
